# Скопируйте в .env и подставьте свои значения.

# --- Postgres -------------------------------------------------------------
# Порт 5433 — как в docker-compose.yml, чтобы не конфликтовать
# с возможным локальным Postgres на 5432.
#
# Именно 127.0.0.1, а не localhost: на Windows localhost сначала резолвится
# в IPv6 ::1, и каждое подключение ждёт лишние секунды впустую.
DATABASE_URL=postgresql://rag:rag@127.0.0.1:5433/rag

# --- Anthropic ------------------------------------------------------------
# Можно не задавать, если делали `ant auth login` — SDK подхватит профиль сам.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Поиск ----------------------------------------------------------------
# Сколько чанков отдаём модели как контекст.
TOP_K=5

# --- Эмбеддинги -----------------------------------------------------------
# Модель и её размерность должны меняться ВМЕСТЕ, а после смены нужен
# `python -m rag reset` — размерность зашита в тип колонки VECTOR(n).
#
# 384 dim, ~220 МБ — дефолт, быстрый, знает русский:
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
#
# 1024 dim, ~2.2 ГБ — заметно точнее на русском, но качать долго:
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_DIM=1024

# --- Нарезка --------------------------------------------------------------
CHUNK_TARGET_CHARS=1000
CHUNK_OVERLAP_CHARS=150
